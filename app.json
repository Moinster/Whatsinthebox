{
  "expo": {
    "name": "What's in the Box",
    "slug": "whatsinthebox",
    "scheme": "whatsinthebox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whatsinthebox.app"
    },
    "android": {
      "package": "com.whatsinthebox.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow What's in the Box to use the camera to scan box QR codes and take photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow What's in the Box to choose photos of your boxes and items.",
          "cameraPermission": "Allow What's in the Box to take photos of your boxes and items.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
